<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <EmbeddedResource Include="casefold.json" LogicalName="casefold.json" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" GeneratePathProperty="true" />
    <Content Include="$(PkgRapidOcrNet)/models/v5/*" Link="models/v5/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="model-manifest.json" Link="models/v5/model-manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Models/row-classifier.onnx;Models/row-classifier.json" Link="models/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Only the test needs the reference row; the package leaves it out. -->
    <Content Include="Models/row-classifier-reference.png" Link="models/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="../licenses/*" Link="licenses/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
